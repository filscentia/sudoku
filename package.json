{
  "name": "sudoku",
  "type": "module",
  "version": "1.0.0",
  "description": "An investigation into the Sudoku puzzle style",
  "main": "index.js",
  "scripts": {
    "test": "mocha test --recursive",
    "clean": "rimraf dist",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint '*/**/*.{js,ts,tsx}' --quiet --fix",
    "build": "npm run format && npm run clean && npm run lint && echo Using TypeScript && tsc --version && tsc -p tsconfig.build.json --pretty && npm link"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filscentia/sudoku.git"
  },
  "author": "mbw",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/filscentia/sudoku/issues"
  },
  "homepage": "https://github.com/filscentia/sudoku#readme",
  "dependencies": {
    "@ampretia/qmit": "file:ampretia-qmit-0.0.10.tgz",
    "cli-boxes": "^4.0.1",
    "emittery": "^1.2.0",
    "lodash": "^4.17.21",
    "terminal-kit": "^3.1.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@tsconfig/node-lts": "^22.0.2",
    "@tsconfig/node20": "^20.1.6",
    "@types/lodash": "^4.14.168",
    "@types/node": "^24.3.1",
    "@types/terminal-kit": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "mocha": "^11.7.2",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
